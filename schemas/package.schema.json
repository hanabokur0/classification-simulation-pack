project:
  name: Classification Simulation Pack
  description: >
    事業や企画を何度も試し、
    成功条件と失敗理由をReceiptとして返すGitHubツール。
  target_users:
    - 新規事業を考えている人
    - 企画を比較したい人
    - 投資や導入を判断する人

success_definition:
  useful:
    classes:
      - useful_free_tool
      - small_paid_product
      - repeatable_business
      - platform_signal

  paid:
    classes:
      - small_paid_product
      - repeatable_business
      - platform_signal

  business:
    classes:
      - repeatable_business
      - platform_signal

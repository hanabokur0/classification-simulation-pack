    evidence_refs: []
  local_gpu_headroom_units:
    distribution: integer_uniform
    min: 4
    max: 40
    label: 東京LOCAL GPU余力（SCENARIO）
    confidence: insufficient
    missing_policy: continue_with_warning
    evidence_refs: []
  local_energy_cost_jpy_kwh:

    evidence_refs: []
  local_thermal_margin:
    distribution: uniform
    min: 0.35
    max: 0.75
    label: 東京LOCAL 冷却余裕Proxy（SCENARIO）
    confidence: insufficient
    missing_policy: continue_with_warning
    evidence_refs: []

constants: {}
context:
  domain: compute_routing
  source_region: tokyo
  destination_service_area: tohoku_epco_area
  candidate_nodes:
    1: sendai
    2: akita
    3: niigata
  scenario_notice: All capacity, cost, latency, renewable, and thermal ranges are synthetic placeholders until replaced by measured evidence.
package:
  id: compute_routing
  taxonomy: taxonomy.yaml
  evaluator: evaluator.yaml

funnel:
  - id: routable
    label: ROUTE判断に必要な最低条件が揃う
    classes: [route, shift, local]
    next_action: HOLD要因を除外し、実測テレメトリへ接続する。
  - id: remote_candidate
    label: 東北電力エリアへの遠隔利用候補になる
    classes: [route, shift]
    next_action: GPU・系統余力・RTT・価格・冷却の実測レンジで再シミュレーションする。
  - id: direct_route
    label: 追加待機なしで直接ROUTEできる
    classes: [route]
    next_action: 小規模・可逆な実ワークロードでルーティングReceiptを取得する。

metrics:
  - flexibility_score
  - sendai_score
  - akita_score
  - niigata_score
  - local_score
  - best_direct_score
  - best_shift_score
  - best_direct_node_code
  - best_shift_node_code
  - direct_remote_advantage
  - shift_remote_advantage
  - sendai_candidate
  - akita_candidate
  - niigata_candidate

safety_net:
  enabled: true
  min_outcome_ratio: 0.05
  max_next_packages: 4

evidence_pack:
  id: tohoku-compute-routing-scenario-assumptions
  version: 0.1.0
  items: []

workload:
  id: compute-routing-monte-carlo
  version: 0.1.0
  estimated_runs:
    min: 200
    target: 2000
    max: 20000
  resource:
    cpu: preferred
    gpu: optional
    memory_gb: 4
  execution:
    interruptible: true
    checkpointable: true
    resumable: true
    divisible: true
  expansion:
    allowed: true
    max_depth: 4
    stop_when_range_reduction_below: 0.01
